4af08f5dc1c530098f921ce9d849e23","path":"/cci-toolbox-usage-viewers/build/c4af08f5dc1c530098f921ce9d849e23.html"},"text/plain":{"content":"<xarray.Dataset> Size: 350MB\nDimensions:    (time: 12, lat: 2701, lon: 2700, bnds: 2)\nCoordinates:\n  * time       (time) datetime64[ns] 96B 2019-01-16T12:00:00 ... 2019-12-16T1...\n    time_bnds  (time, bnds) datetime64[ns] 192B dask.array<chunksize=(12, 2), meta=np.ndarray>\n  * lon        (lon) float64 22kB 24.5 24.5 24.5 24.5 ... 25.0 25.0 25.0 25.0\n  * lat        (lat) float64 22kB 6.2 6.2 6.2 6.199 6.199 ... 5.7 5.7 5.7 5.7\nDimensions without coordinates: bnds\nData variables:\n    CL         (time, lat, lon) uint8 88MB dask.array<chunksize=(1, 1080, 900), meta=np.ndarray>\n    JD         (time, lat, lon) int16 175MB dask.array<chunksize=(1, 1080, 900), meta=np.ndarray>\n    LC         (time, lat, lon) uint8 88MB dask.array<chunksize=(1, 1080, 900), meta=np.ndarray>\nAttributes: (12/16)\n    Conventions:                CF-1.7\n    title:                      esacci.FIRE.mon.L3S.BA.MSI-(Sentinel-2).Senti...\n    date_created:               2026-02-27T14:22:43.806571\n    processing_level:           L3S\n    time_coverage_start:        2019-01-01T00:00:00\n    time_coverage_end:          2020-01-01T00:00:00\n    ...                         ...\n    geospatial_lon_max:         24.999999999313346\n    geospatial_lat_resolution:  0.0001851851851855102\n    geospatial_lat_min:         5.699814814814815\n    geospatial_lat_max:         6.200000000000001\n    geospatial_bounds_crs:      CRS84\n    geospatial_bounds:          POLYGON((24.499999999382013 5.699814814814815...","content_type":"text/plain"}}},"children":[],"key":"g5xnhDcqKZ"}],"key":"ZND2Tsxb2m"}],"key":"pEKHr1UNgh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Now that we have created a subset, we can take care of a proper visualisation of the JD variable. As a matter of fact, this variable has a special encoding. The value 0 indicates that a pixel has not been burned, -1 stands for pixels that were not observed in the month (e.g., due to high cloud coverage), and -2 stands for pixels that cannot be burned due to the type of land cover. For all other pixels, the values between 1-366 denote the day of year in which first a fire was detected. The dataset is divided into months, meaning that for January the value range is between 1 and 31, for February 32 to 59, and so on.\nWe aim to go for a visualisation where the julian day is scaled for each month to the same scale of red shades. But first, we define the colors, values and labels for the three catagories between -2 and 0.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zWEVOKkzJ0"}],"key":"Yf0EkGQlhZ"}],"key":"FFdb3wsI1s"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"base_category_colors = [\n    \"#1e90ff\",  # dodger blue\n    \"#91a3b0\",  # cadet grey\n    \"#000000\",  # black\n]\nbase_category_labels = [\n    \"Non-burnable\",\n    \"Not observed\",\n    \"Unburnt\"\n]\nbase_category_values = [-2, -1, 0]","key":"asngZ6EBFC"},{"type":"outputs","id":"Ms0K9T_eZ2TQr3eUFa_ne","children":[],"key":"THFLC2FL7H"}],"key":"VFLYSmT0lp"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have this defined, we can continue with the definition of the red color range. For this, we take the predefined “Reds” color map from the matplotlib package and divide it into 31 categories. We already add the first three colors at the beginning.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RmVsOqZhaH"}],"key":"kELtiZTyjZ"}],"key":"CxQdr0KOYH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib as plt\nimport numpy as np\n\ncont_cmap = plt.colormaps[\"Reds\"]\ncont_colors = cont_cmap(np.linspace(0.2, 1, num=31))\ncolors = base_category_colors + cont_colors.tolist()","key":"uFEA5Kx2xB"},{"type":"outputs","id":"MNMT0kUmrrQdFHy0mGTp7","children":[],"key":"bs7UjYqCLY"}],"key":"EPCicsrWkW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Just to see what color map we will end up with, we display it as a ListedColorMap.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PRgfGuvpHg"}],"key":"lFUiSioZ7b"}],"key":"PWaHtiwoSg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from matplotlib.colors import ListedColormap\n\nListedColormap(colors, name=\"FIRE LC Color Map\")","key":"CdK4TL8Vhf"},{"type":"outputs","id":"LCXB_eTLvNntGziMMmQR9","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":16,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"68f4d259a03c44a34c3d2a21d1cdc5f8","path":"/cci-toolbox-usage-viewers/build/68f4d259a03c44a34c3d2a21d1cdc5f8.png"},"text/html":{"content":"<div style=\"vertical-align: middle;\"><strong>FIRE LC Color Map</strong> </div><div class=\"cmap\"><img alt=\"FIRE LC Color Map colormap\" title=\"FIRE LC Color Map\" style=\"border: 1px solid #555;\" src=\"data:image/png;base64,\"></div><div style=\"vertical-align: middle; max-width: 514px; display: flex; justify-content: space-between;\"><div style=\"float: left;\"><div title=\"#1e90ffff\" style=\"display: inline-block; width: 1em; height: 1em; margin: 0; vertical-align: middle; border: 1px solid #555; background-color: #1e90ffff;\"></div> under</div><div style=\"margin: 0 auto; display: inline-block;\">bad <div title=\"#00000000\" style=\"display: inline-block; width: 1em; height: 1em; margin: 0; vertical-align: middle; border: 1px solid #555; background-color: #00000000;\"></div></div><div style=\"float: right;\">over <div title=\"#67000dff\" style=\"display: inline-block; width: 1em; height: 1em; margin: 0; vertical-align: middle; border: 1px solid #555; background-color: #67000dff;\"></div></div></div>","content_type":"text/html"},"text/plain":{"content":"<matplotlib.colors.ListedColormap at 0x77b2c21653d0>","content_type":"text/plain"}}},"children":[],"key":"rZoSp9LZtA"}],"key":"hoSg6Bz9bH"}],"key":"tRJNyCY7n3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Looks good! We may now continue with creating labels for the days. For the sake of readability, we do not define a label for each day, but for every fifth day. Using these labels will cause that in the legend we will see the day of the month, not the day of the year.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IJb5Yrh6mh"}],"key":"T2fKIpAhAA"}],"key":"qq3aqFCKYE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"labels = [\"\"] * 31\nfor i in range(5, 31, 5):\n    labels[i] = i\nlabels = base_category_labels + labels","key":"eSJBLu3wwg"},{"type":"outputs","id":"IyQ7ZQlcJFJR916F0tEWV","children":[],"key":"xwYOlYyznT"}],"key":"qoWgFkurwu"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, we have to define the actual indices for each month separately, as the value ranges change with every month. For this, we determine the range from the number of days per month (as we only deal with the year 2019, we don’t have to bother with the issue of leap years).","position":{"start":{"line":1,"colu